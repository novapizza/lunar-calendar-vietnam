{
  "name": "lunar-calendar-vietnam",
  "private": true,
  "description": "Lịch Âm Việt Nam: web (apps/web), iOS (apps/ios), Android (apps/android) and the data they share (shared/).",
  "workspaces": [
    "shared",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @lunar/web",
    "build": "npm run build -w @lunar/web",
    "preview": "npm run preview -w @lunar/web",
    "lint": "npm run lint -w @lunar/web",
    "gen": "npm run gen -w @lunar/shared",
    "check": "npm run check -w @lunar/shared"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
