<?xml version="1.0" encoding="utf-8"?>
<!-- Tờ lịch widget: the sheet's double gold hairline frame (TearOffSheet: hero-accent at 45 %, then 25 % 3dp inside). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/widget_gold_frame" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/widget_gold_frame_inner" />
        </shape>
    </item>
</layer-list>
